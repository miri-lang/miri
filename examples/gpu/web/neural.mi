// On-device neural-network training (the capstone): a 2-12-12-1 MLP with 205
// parameters is trained, entirely on the GPU, to classify a two-arm spiral.
// JS only paints the result and reads back the loss/accuracy HUD — every bit
// of training (forward pass, analytic backprop, weight update) is a Miri GPU
// kernel.
//
// The training is a faithful full-batch backprop step, run by a single GPU
// thread each frame. It forwards every sample through the net, backpropagates
// the binary-cross-entropy error to an exact gradient, and takes one momentum
// SGD step (lr 0.25, momentum 0.9). This is only expressible on-device because
// the gradient and per-sample activations live in per-invocation local `Array`
// scratch (g[205], h1/h2/d1/d2) that is read-modify-written across the batch —
// no cross-thread reduction, no host round-trip. Weights and velocities
// ping-pong (a -> b); the host swaps a/b between frames, so each displayed
// frame is one training step and the decision field visibly sharpens.
//
// The dataset itself cycles on a timer — spiral, then rings, then xor — so the
// demo shows the same net re-forming its decision boundary for three different
// shapes. The mode is a pure function of frame time, so no host coordination or
// persistent state is needed; the net simply adapts in place as the data changes.
//
// A `gpu frame` block runs four buffer-disjoint passes:
// 1. Train:   one thread — forward + backprop over the batch, momentum update.
// 2. Stats:   one thread — post-step loss + accuracy for the HUD readback.
// 3. Dataset: regenerate the current mode's points (`train` stays the first pass
//             so it keeps ownership of the weight ping-pong).
// 4. Render:  per-pixel decision field with confidence bands, a pulsing decision
//             boundary, and the data points overlaid.
// Every math-intrinsic result is anchored to f32 so the device path stays 32-bit.

use system.collections.array
use system.math
use system.io

// Network shape: 2 inputs -> 12 -> 12 -> 1 output.
const IN = 2
const H1 = 12
const H2 = 12

// Weight layout inside the flat parameter buffer (205 floats):
//   W1 [24] @0   b1 [12] @24   W2 [144] @36   b2 [12] @180   W3 [12] @192   b3 @204
const W1 = 0
const B1 = 24
const W2 = 36
const B2 = 180
const W3 = 192
const B3 = 204
const PARAMS = 205

// Dataset: 220 points, each (x, y, label in {0, 1}); PER_ARM points per class.
const SAMPLES = 220
const PER_ARM = 110
const DATA = SAMPLES * 3

// Decision-field surface: a 1280×720 (16:9) RGBA image.
const CW = 1280
const CH = 720
const PIXELS = CW * CH
const PAINT = PIXELS * 4

// Weights and velocities (ping-ponged a -> b).
gpu var wa = Array<f32, PARAMS>()
gpu var wb = Array<f32, PARAMS>()
gpu var va = Array<f32, PARAMS>()
gpu var vb = Array<f32, PARAMS>()

// Dataset points and the [loss, accuracy] HUD stats.
gpu var data = Array<f32, DATA>()
gpu var stats = Array<f32, 2>()

// Decision-field paint output (1280×720 RGBA).
gpu var paint = Array<f32, PAINT>()

fn rand_unit(key i32) f32
    let h = hash_u32(key as u32)
    return (h as f32) / (4294967295.0 as f32)

// Seed weights with small per-layer scales (biases start at zero); zero the
// velocities. Matches the reference net's Xavier-ish initialization.
forall i in 0..PARAMS
    var scale = 0.0
    if i < B1
        scale = 0.65
    if i >= W2 and i < B2
        scale = 0.5
    if i >= W3 and i < B3
        scale = 0.68
    wa[i] = ((rand_unit(i + 1) * 2.0 - 1.0) * scale) as f32
    va[i] = 0.0

// Seed a two-arm spiral: points 0..PER_ARM are class 0, the rest class 1.
forall s in 0..SAMPLES
    let c = s / PER_ARM
    let i = s - c * PER_ARM
    let t = ((i as f32) / (PER_ARM as f32)) as f32
    let r = (0.13 + 0.74 * t) as f32
    let th = (t * 4.4 + (c as f32) * (3.14159265 as f32)) as f32
    let nx = ((rand_unit(s * 2 + 1) - 0.5) * 0.07) as f32
    let ny = ((rand_unit(s * 2 + 2) - 0.5) * 0.07) as f32
    data[s * 3] = (r * (cos(th) as f32) + nx) as f32
    data[s * 3 + 1] = (r * (sin(th) as f32) + ny) as f32
    data[s * 3 + 2] = c as f32

// Clear the paint buffer. This top-level 2-D pass over the exact display extent
// tells the web-gpu backend the canvas is 1280×720 (16:9); the per-frame render
// pass is 1-D, which alone would leave the canvas shape ambiguous.
forall px, py in 0..CW, 0..CH
    let base = (py * CW + px) * 4
    paint[base] = 0.012
    paint[base + 1] = 0.02
    paint[base + 2] = 0.046
    paint[base + 3] = 1.0

gpu frame
    // Pass 1: one full-batch backprop step. A single thread forwards every
    // sample, backpropagates the cross-entropy error into the exact gradient
    // `g`, then applies the momentum update wa/va -> wb/vb. The gradient and
    // the activation buffers are per-invocation local scratch arrays.
    forall t in 0..1
        var g = Array<f32, PARAMS>()
        var h1 = Array<f32, H1>()
        var h2 = Array<f32, H2>()
        var d1 = Array<f32, H1>()
        var d2 = Array<f32, H2>()
        var s = 0
        while s < SAMPLES
            let x0 = data[s * 3]
            let x1 = data[s * 3 + 1]
            let lbl = data[s * 3 + 2]

            // Forward pass.
            var j = 0
            while j < H1
                let a1 = (wa[W1 + j * IN] * x0 + wa[W1 + j * IN + 1] * x1 + wa[B1 + j]) as f32
                h1[j] = tanh(a1) as f32
                j = j + 1
            j = 0
            while j < H2
                var a2 = wa[B2 + j]
                var k = 0
                while k < H1
                    a2 = (a2 + wa[W2 + j * H1 + k] * h1[k]) as f32
                    k = k + 1
                h2[j] = tanh(a2) as f32
                j = j + 1
            var y = wa[B3]
            j = 0
            while j < H2
                y = (y + wa[W3 + j] * h2[j]) as f32
                j = j + 1
            let p = (1.0 / (1.0 + (exp(0.0 - y) as f32))) as f32

            // Backward pass: accumulate the exact gradient into `g`.
            let ds = (p - lbl) as f32
            g[B3] = (g[B3] + ds) as f32
            j = 0
            while j < H2
                g[W3 + j] = (g[W3 + j] + ds * h2[j]) as f32
                d2[j] = (ds * wa[W3 + j] * (1.0 - h2[j] * h2[j])) as f32
                j = j + 1
            j = 0
            while j < H2
                g[B2 + j] = (g[B2 + j] + d2[j]) as f32
                var k = 0
                while k < H1
                    g[W2 + j * H1 + k] = (g[W2 + j * H1 + k] + d2[j] * h1[k]) as f32
                    k = k + 1
                j = j + 1
            var k = 0
            while k < H1
                var acc = 0.0
                j = 0
                while j < H2
                    acc = (acc + d2[j] * wa[W2 + j * H1 + k]) as f32
                    j = j + 1
                d1[k] = (acc * (1.0 - h1[k] * h1[k])) as f32
                k = k + 1
            k = 0
            while k < H1
                g[B1 + k] = (g[B1 + k] + d1[k]) as f32
                g[W1 + k * IN] = (g[W1 + k * IN] + d1[k] * x0) as f32
                g[W1 + k * IN + 1] = (g[W1 + k * IN + 1] + d1[k] * x1) as f32
                k = k + 1
            s = s + 1

        // Momentum SGD update (lr 0.25, momentum 0.9), averaged over the batch.
        let sc = (0.25 / (SAMPLES as f32)) as f32
        var i = 0
        while i < PARAMS
            let nv = (0.9 * va[i] - sc * g[i]) as f32
            vb[i] = nv
            wb[i] = (wa[i] + nv) as f32
            i = i + 1

    // Pass 2: post-step loss + accuracy over the batch for the HUD readback.
    forall t in 0..1
        var h1 = Array<f32, H1>()
        var h2 = Array<f32, H2>()
        var loss = 0.0
        var correct = 0.0
        var s = 0
        while s < SAMPLES
            let x0 = data[s * 3]
            let x1 = data[s * 3 + 1]
            let lbl = data[s * 3 + 2]
            var j = 0
            while j < H1
                let a1 = (wb[W1 + j * IN] * x0 + wb[W1 + j * IN + 1] * x1 + wb[B1 + j]) as f32
                h1[j] = tanh(a1) as f32
                j = j + 1
            j = 0
            while j < H2
                var a2 = wb[B2 + j]
                var k = 0
                while k < H1
                    a2 = (a2 + wb[W2 + j * H1 + k] * h1[k]) as f32
                    k = k + 1
                h2[j] = tanh(a2) as f32
                j = j + 1
            var y = wb[B3]
            j = 0
            while j < H2
                y = (y + wb[W3 + j] * h2[j]) as f32
                j = j + 1
            let p = clamp(1.0 / (1.0 + (exp(0.0 - y) as f32)), 0.000001, 0.999999) as f32
            loss = (loss - (lbl * (log(p) as f32) + (1.0 - lbl) * (log(1.0 - p) as f32))) as f32
            let hit = 1.0 if (p - 0.5) * (lbl - 0.5) > 0.0 else 0.0
            correct = (correct + hit) as f32
            s = s + 1
        stats[0] = (loss / (SAMPLES as f32)) as f32
        stats[1] = (correct / (SAMPLES as f32)) as f32

    // Pass 3: regenerate the dataset for the current mode. A timer cycles the
    // shape every SECS_PER_MODE seconds (spiral -> rings -> xor), so the field
    // visibly re-forms for each one; the net adapts in place (no weight reset).
    // Within a mode the layout is a deterministic function of the point index,
    // so it is stable across frames and the net can learn it. `train` stays the
    // first pass (it owns the weight ping-pong); this pass feeds the render below
    // and next frame's training, so the shape only lags a frame at a boundary.
    forall s in 0..SAMPLES
        // Mode advances every 6 seconds: spiral (0), rings (1), xor (2).
        let mode = (floor(frame.time / 6.0) as i32) % 3
        var dx = 0.0
        var dy = 0.0
        var lbl = 0.0
        if mode == 0
            // Two-arm spiral: points 0..PER_ARM are class 0, the rest class 1.
            let c = s / PER_ARM
            let i = s - c * PER_ARM
            let tt = ((i as f32) / (PER_ARM as f32)) as f32
            let r = (0.13 + 0.74 * tt) as f32
            let th = (tt * 4.4 + (c as f32) * (3.14159265 as f32)) as f32
            dx = (r * (cos(th) as f32) + (rand_unit(s * 2 + 1) - 0.5) * 0.07) as f32
            dy = (r * (sin(th) as f32) + (rand_unit(s * 2 + 2) - 0.5) * 0.07) as f32
            lbl = c as f32
        if mode == 1
            // Concentric rings: an inner disk (class 1) in an outer annulus.
            let inner = s < 100
            let rad = (sqrt(rand_unit(100003 + s * 3 + 1)) * 0.34) as f32 if inner else (0.58 + rand_unit(100003 + s * 3 + 1) * 0.27) as f32
            let ang = (rand_unit(100003 + s * 3 + 2) * (6.2831853 as f32)) as f32
            dx = (rad * (cos(ang) as f32)) as f32
            dy = (rad * (sin(ang) as f32)) as f32
            lbl = 1.0 if inner else 0.0
        if mode == 2
            // XOR: class 1 where x and y share a sign, class 0 otherwise.
            let px = ((rand_unit(200003 + s * 3 + 1) * 2.0 - 1.0) * 0.85) as f32
            let py = ((rand_unit(200003 + s * 3 + 2) * 2.0 - 1.0) * 0.85) as f32
            dx = px
            dy = py
            lbl = 1.0 if px * py > 0.0 else 0.0
        data[s * 3] = dx
        data[s * 3 + 1] = dy
        data[s * 3 + 2] = lbl
    // Pass 4: decision field. Evaluate the trained net per pixel, shade by
    // class and confidence, add outward-flowing confidence bands and a pulsing
    // decision-boundary seam, then overlay the data points.
    forall px in 0..PIXELS
        let ix = px % CW
        let iy = px / CW
        // Aspect-corrected input square: y spans [-1, 1], x widens by 16:9.
        let gx = ((((ix as f32) + 0.5) / (CW as f32)) - 0.5) * 2.0 * ((CW as f32) / (CH as f32)) as f32
        let gy = (0.5 - (((iy as f32) + 0.5) / (CH as f32))) * 2.0 as f32

        var h1 = Array<f32, H1>()
        var h2 = Array<f32, H2>()
        var j = 0
        while j < H1
            let a1 = (wb[W1 + j * IN] * gx + wb[W1 + j * IN + 1] * gy + wb[B1 + j]) as f32
            h1[j] = tanh(a1) as f32
            j = j + 1
        j = 0
        while j < H2
            var a2 = wb[B2 + j]
            var k = 0
            while k < H1
                a2 = (a2 + wb[W2 + j * H1 + k] * h1[k]) as f32
                k = k + 1
            h2[j] = tanh(a2) as f32
            j = j + 1
        var y = wb[B3]
        j = 0
        while j < H2
            y = (y + wb[W3 + j] * h2[j]) as f32
            j = j + 1
        let p = (1.0 / (1.0 + (exp(0.0 - y) as f32))) as f32

        // Class side (blue below 0.5, gold above) shaded by squared confidence.
        let conf = (abs(p - 0.5) * 2.0) as f32
        let sr = 0.16 if p < 0.5 else 1.0
        let sg = 0.31 if p < 0.5 else 0.84
        let sb = 0.82 if p < 0.5 else 0.24
        let fill = (0.10 + 0.60 * conf * conf) as f32
        var cr = (0.012 + sr * fill) as f32
        var cg = (0.02 + sg * fill) as f32
        var cb = (0.046 + sb * fill) as f32

        // Confidence iso-contours that drift outward from the boundary.
        let tm = frame.time
        let bnd = (abs(fract(p * 9.0 - tm * 0.25) - 0.5)) as f32
        let bw = (smoothstep(0.44, 0.5, bnd) * 0.10) as f32
        cr = (cr + sr * bw) as f32
        cg = (cg + sg * bw) as f32
        cb = (cb + sb * bw) as f32

        // Decision boundary: a bright, breathing seam at p = 0.5.
        let e = (abs(p - 0.5) / 0.035) as f32
        let edge = (exp(0.0 - e * e)) as f32
        let pulse = (0.72 + 0.28 * (sin(tm * 2.4) as f32)) as f32
        let seam = (edge * 0.55 * pulse) as f32
        cr = (cr + 0.90 * seam) as f32
        cg = (cg + 0.95 * seam) as f32
        cb = (cb + 1.0 * seam) as f32

        // Data-point overlay: soft dots colored by their true label.
        var s = 0
        while s < SAMPLES
            let dx = (gx - data[s * 3]) as f32
            let dy = (gy - data[s * 3 + 1]) as f32
            let dd = (dx * dx + dy * dy) as f32
            if dd < 0.0016
                let lbl = data[s * 3 + 2]
                let pr = 0.45 if lbl < 0.5 else 1.0
                let pg = 0.62 if lbl < 0.5 else 0.88
                let pb = 1.0 if lbl < 0.5 else 0.4
                let core = (1.0 - smoothstep(0.0008, 0.0016, dd)) as f32
                cr = (cr + (pr - cr) * core) as f32
                cg = (cg + (pg - cg) * core) as f32
                cb = (cb + (pb - cb) * core) as f32
            s = s + 1

        let base = px * 4
        paint[base] = cr
        paint[base + 1] = cg
        paint[base + 2] = cb
        paint[base + 3] = 1.0


// Native smoke: after the seed and one training step, report the post-step loss
// and accuracy. Training reduces the loss below the ~0.7 random-init baseline,
// verifying the on-device forward + backprop + update chain end to end.
let h = stats
let loss_milli = (h[0] * 1000.0) as i32
let acc_milli = (h[1] * 1000.0) as i32
println(f"loss_milli={loss_milli} acc_milli={acc_milli}")
