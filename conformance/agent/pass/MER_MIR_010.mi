// summary: Accepted counterpart of MER_MIR_010: Invalid GPU Launch Arguments does not fire.
// command: build
// The program launches a GPU kernel, so running it would need a device the
// machine may not have. Building carries it through kernel lowering, which
// is the stage that raises the diagnostic this fixture asserts stays quiet.
use system.gpu

gpu fn my_kernel()
    let x = 1

fn main()
    my_kernel().launch(Dim3(1, 1, 1), Dim3(1, 1, 1))
