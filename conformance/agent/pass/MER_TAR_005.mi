// summary: Accepted counterpart of MER_TAR_005: Invalid GPU Parallel Construct does not fire.
// command: build
// The reduce over a device-resident buffer dispatches to the GPU, so running
// this would need a device the machine may not have. Building carries the
// program past the check that raises the diagnostic and stops before dispatch.
use system.gpu

fn main()
    gpu let arr = [0, 1, 2, 3]
    let sum = arr.reduce(0, fn(acc i32, x i32) i32: acc + x)
