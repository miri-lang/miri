// summary: Accepted counterpart of MER_TYP_011: Non-Exhaustive Enum Match does not fire.
// expect-stdout: test
use system.os

fn main()
    let err = EnvError.InvalidName("test")
    match err
        EnvError.InvalidName(s): println(s)
        EnvError.InvalidValue(s): println(s)
        EnvError.Other(s): println(s)
        default: println("unknown")
