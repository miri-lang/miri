// summary: Accepted counterpart of MER_OWN_008: take() empties the optional field and hands its value to the keeper.
// expect-stdout: true false
// expect-stdout: closed 1
class Conn
    public var id int
    fn init(id int)
        self.id = id
    fn drop(self)
        println(f"closed {self.id}")

class Pool
    public var spare Conn?
    fn init()
        self.spare = Some(Conn(1))

fn keep(c Conn?) Conn?
    return c

fn main()
    let pool = Pool()
    let kept = keep(pool.spare.take())
    println(f"{kept.is_some()} {pool.spare.is_some()}")
