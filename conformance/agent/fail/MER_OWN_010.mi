// expect: MER_OWN_010
// summary: Triggers MER_OWN_010: a list of a resource that does not implement Cloneable is cloned.
use system.collections.list

class Conn
    public var id int
    fn init(id int)
        self.id = id
    fn drop(self)
        println(f"closed {self.id}")

fn main()
    let conns = List([Conn(1), Conn(2)])
    let copy = conns.clone()
    println(f"{copy.length()}")
