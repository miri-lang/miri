// expect: MER_TYP_088
// summary: Triggers MER_TYP_088: a subclass redeclares a generic method of the class it extends.
class Animal
    fn speak<T>(x T) String
        return "animal"

class Dog extends Animal
    fn speak<T>(x T) String
        return "dog"

fn main()
    let a Animal = Dog()
    let s = a.speak(1)
