// expect: MER_OWN_012
// summary: Triggers MER_OWN_012: the value of an assignment storing a resource into a list element is passed to a function.
use system.collections.list

class Token
    var id int
    fn drop(self)
        println(f"released {self.id}")

fn show(token Token)
    println(f"{token.id}")

fn main()
    var tokens = List([Token(id: 9)])
    show(tokens[0] = Token(id: 1))
