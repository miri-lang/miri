// expect: MER_OWN_008
// summary: Triggers MER_OWN_008: a function keeps the value of its out parameter, which the caller gets back.
class Conn
    public var id int
    fn init(id int)
        self.id = id
    fn drop(self)
        println(f"closed {self.id}")

fn keep(c Conn) Conn?
    return Some(c)

fn swap(c out Conn) Conn?
    return keep(c)

fn main()
    var c = Conn(1)
    let kept = swap(c)
    println(f"{kept.is_some()} {c.id}")
