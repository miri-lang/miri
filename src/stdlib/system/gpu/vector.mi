use system.accelerator

/// Generic vector types for GPU and CPU computation.
///
/// Vec2, Vec3, and Vec4 are compiler-known inline value types with component-wise
/// operations. They are NOT heap-allocated and do NOT participate in Perceus RC.
/// Component access is via `.x`, `.y`, `.z`, `.w` fields; construction is via
/// `Vec3<f32>(a, b, c)` function-call syntax that mirrors struct initialization.
///
/// A component is constrained to a scalar with a byte width, because that width
/// is the stride a collection spaces its elements by: f32, i32, u32 carry to the
/// GPU, while f64, i64, u64 and the inferred int/float stay on the host (WGSL has
/// no 64-bit vector). Any other component is refused where it is written. The
/// stdlib is minimal because the compiler recognizes Vec as a built-in type and
/// handles layout and lowering directly. This follows the same pattern as Dim3
/// (GPU kernel context dimension).

/// A 2-component vector with generic scalar type T.
/// T must be one of: f32, i32, u32, f64, i64, u64, int, float.
/// Layout: two components, no padding (8 bytes at a 4-byte component).
struct Vec2<T>
    x T
    y T

/// A 3-component vector with generic scalar type T.
/// T must be one of: f32, i32, u32, f64, i64, u64, int, float.
/// Layout: std430-padded to four components (16 bytes at a 4-byte component:
/// three scalars plus 4B of pad); only the three are ever read.
struct Vec3<T>
    x T
    y T
    z T

/// A 4-component vector with generic scalar type T.
/// T must be one of: f32, i32, u32, f64, i64, u64, int, float.
/// Layout: four components, naturally aligned (16 bytes at a 4-byte component).
struct Vec4<T>
    x T
    y T
    z T
    w T
