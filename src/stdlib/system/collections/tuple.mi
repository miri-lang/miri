use system.ops
use system.collections.queryable

/// A fixed-size, ordered collection of elements of the same type.
///
/// Tuples are compiler-intrinsic types created with parenthesized syntax:
///   let t = (1, 2, 3)
///
/// Element access uses dot-index notation:
///   let x = t.0
///
/// This module provides methods for homogeneous tuples (all elements of one
/// type). It backs the tuple literal, so `length()`, `element_at()`,
/// `contains()` and the rest reach every homogeneous tuple without a `use`,
/// as a list literal's methods do. A tuple of `Size` elements of type `T` is a
/// `Tuple<T, Size>`, and its methods read the tuple itself: no copy of it is
/// made for a call.
///
/// Example:
///     let t = (10, 20, 30)
///     println(f"{t.length()}")      // 3
///     println(f"{t.contains(20)}")  // true
public class Tuple<T, Size> implements Queryable<T>, Indexed<T>

    /// Returns the number of elements in the tuple.
    public fn length() int: Size

    /// Returns the element at the given index.
    /// This enables for-loop iteration: `for x in tuple`.
    /// Handled as a built-in operation by the compiler.
    @index_bounds_check("index")
    public fn element_at(index int) T: self[index]
