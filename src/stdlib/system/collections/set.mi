use system.ops
use system.memory

/// A collection of unique elements of a single type.
///
/// Set<T> holds distinct elements and provides methods to add, remove, and check
/// membership. Attempting to add an element already in the set leaves it unchanged.
/// The iteration order is unspecified and must not be relied upon; elements are
/// accessed sequentially via `element_at()`. Sets are passed by reference, so
/// `add()` and `remove()` affect the original; use `clone()` for an independent copy.
///
/// Example:
///     var s = Set<int>()
///     s.add(10)
///     s.add(20)
///     s.add(10)  // no effect; 10 already in set
///     println(f"{s.length()}")       // 2
///     println(f"{s.contains(10)}")   // true
public class Set<T> implements Equatable, Hashable, Iterable<T>, Cloneable

    @allocates
    runtime "core" fn miri_rt_set_new(elem_size int) Self
    @writes("s")
    runtime "core" fn miri_rt_set_free(s Self)
    @reads("s")
    runtime "core" fn miri_rt_set_len(s Self) int
    @writes("s")
    @element("element")
    @stores("element")
    @matches("s")
    runtime "core" fn miri_rt_set_add(s Self, element T) bool
    @reads("s")
    @element("element")
    @matches("s")
    runtime "core" fn miri_rt_set_contains(s Self, element T) bool
    @writes("s")
    @element("element")
    @matches("s")
    runtime "core" fn miri_rt_set_remove(s Self, element T) bool
    @writes("s")
    runtime "core" fn miri_rt_set_clear(s Self)
    @reads("s")
    @returns_element
    runtime "core" fn miri_rt_set_element_at(s Self, index int) T
    @reads("s")
    @copies("s")
    runtime "core" fn miri_rt_set_clone(s Self) Set<T>

    /// Returns the number of unique elements in the set.
    public fn length() int: miri_rt_set_len(self)

    /// Two sets are equal when they hold the same elements, whatever order
    /// they went in. This is what `==` and `!=` compare.
    public fn equals(other Self) bool
        let len = self.length()
        if len != other.length(): return false
        var i = 0
        while i < len
            if not miri_rt_set_contains(other, self.element_at(i)): return false
            i += 1
        return true

    /// A hash consistent with `equals`: sets holding equal elements hash alike
    /// whatever order they went in, since each element's hash is folded in
    /// with `^`, which ignores order.
    public fn hash() int
        let len = self.length()
        var elements = 0
        var i = 0
        while i < len
            elements = elements ^ hash_combine(0, self.element_at(i).hash())
            i += 1
        return hash_combine(len, elements)

    /// Returns the element at the given sequential index.
    /// This enables for-loop iteration: `for x in set`.
    public fn element_at(index int) T: miri_rt_set_element_at(self, index)

    /// Returns an iterator over the set's elements, in the set's unspecified
    /// order. The iterator walks the set as it is now: a later write to this
    /// set leaves the walk unchanged.
    public fn iterator() Iterator<T>
        return SetIterator<T>(source: self)

    /// Adds an element to the set if not already present.
    public fn add(element T) bool: miri_rt_set_add(self, element)

    /// Returns true if the set contains the given element.
    public fn contains(element T) bool: miri_rt_set_contains(self, element)

    /// Removes the given element from the set.
    public fn remove(element T) bool: miri_rt_set_remove(self, element)

    /// Removes all elements from the set.
    public fn clear()
        miri_rt_set_clear(self)

    /// Returns true if the set has no elements.
    public fn is_empty() bool: self.length() == 0

    /// Returns a deep copy of this set.
    public fn clone() Set<T>
        return miri_rt_set_clone(self)

    /// Returns a new Set containing only elements for which `f` returns true.
    public fn filter(f fn(T) bool) {T}
        var result = Set<T>()
        var i = 0
        let n = self.length()
        while i < n
            let item = self.element_at(i)
            if f(item)
                result.add(item)
            i += 1
        return result

    /// Returns a new Set with each element transformed by `f`.
    public fn map(f fn(T) T) {T}
        var result = Set<T>()
        var i = 0
        let n = self.length()
        while i < n
            result.add(f(self.element_at(i)))
            i += 1
        return result

    /// Reduces all elements to a single value by applying `f`.
    public fn reduce(init T, f fn(T, T) T) T
        var acc = init
        var i = 0
        let n = self.length()
        while i < n
            acc = f(acc, self.element_at(i))
            i += 1
        return acc

/// Hands out a set's elements one at a time, in the set's unspecified order.
///
/// The iterator holds the set it walks. A set is a value, so a write to the
/// set the iterator came from, made during the walk, copies that set and
/// leaves the walk on the elements it started with.
public class SetIterator<T> implements Iterator<T>
    private var source Set<T>
    private var slot int

    @reads("s")
    runtime "core" fn miri_rt_set_next_slot(s Set<T>, start int) int
    @reads("s")
    @returns_element
    runtime "core" fn miri_rt_set_element_in_slot(s Set<T>, slot int) T

    /// Starts a walk over `source` at its first slot.
    fn init(source Set<T>)
        self.source = source
        self.slot = 0

    /// Returns the next element, or `None` once every element has been
    /// returned.
    public fn next() T?
        let found = miri_rt_set_next_slot(self.source, self.slot)
        if found < 0
            return None
        self.slot = found + 1
        return Some(miri_rt_set_element_in_slot(self.source, found))
