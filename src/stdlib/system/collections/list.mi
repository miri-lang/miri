use system.ops
use system.collections.queryable
use system.collections.transformable
use system.collections.foldable
use system.collections.sequenced
use system.memory
use system.accelerator

/// A dynamic-length sequence of elements of a single type.
///
/// List<T> grows and shrinks at runtime, allowing elements to be added, removed,
/// and accessed by index. To create a list from a literal, use `List([1, 2, 3])`.
/// To create an empty list, use `List<T>()`. Lists are passed by reference, so
/// `push`, `set`, and other mutations affect the original; use `clone()` to make
/// an independent copy.
///
/// Example:
///     var l = List<int>()
///     l.push(10)
///     l.push(20)
///     println(f"{l.length()}")  // 2
///     println(f"{l.get(0)}")    // 10
public class List<T> implements Queryable<T>, Iterable<T>, Cloneable, Transformable<T>, Foldable<T>, Sequenced<T>, Accelerable

    runtime "core" fn miri_rt_list_new(elem_size int) Self
    runtime "core" fn miri_rt_list_free(l Self)
    runtime "core" fn miri_rt_list_len(l Self) int
    runtime "core" fn miri_rt_list_push(l Self, item T)
    runtime "core" fn miri_rt_list_pop(l Self) bool
    runtime "core" fn miri_rt_list_set(l Self, index int, item T) bool
    runtime "core" fn miri_rt_list_insert(l Self, index int, item T) bool
    runtime "core" fn miri_rt_list_remove(l Self, index int) bool
    runtime "core" fn miri_rt_list_take_at(l Self, index int) bool
    runtime "core" fn miri_rt_list_clear(l Self)
    runtime "core" fn miri_rt_list_reverse(l Self)
    runtime "core" fn miri_rt_list_sort(l Self)
    runtime "core" fn miri_rt_list_clone(l Self) List<T>

    /// Returns the number of elements in the list.
    public fn length() int: miri_rt_list_len(self)

    /// Returns the element at the given index.
    /// This enables for-loop iteration: `for x in list`.
    @index_bounds_check("index")
    public fn element_at(index int) T: self[index]

    /// Appends an element to the end of the list.
    public fn push(item T)
        miri_rt_list_push(self, item)

    /// Removes and returns the last element, or None if the list is empty.
    ///
    /// The element leaves the list owned by the caller: the runtime only shrinks
    /// the length, so releasing it here would free the value this returns.
    public fn pop() T?
        let len = self.length()
        if len == 0: return None
        let item = self[len - 1]
        miri_rt_list_pop(self)
        return item

    /// Returns the element at the given index.
    @index_bounds_check("index")
    public fn get(index int) T: self[index]

    /// Sets the element at the given index.
    @index_bounds_check("index")
    public fn set(index int, value T)
        miri_rt_list_set(self, index, value)

    /// Inserts an element at the given index.
    @index_bounds_check("index")
    public fn insert(index int, item T)
        miri_rt_list_insert(self, index, item)

    /// Removes and returns the element at the given index, or None when the
    /// index is negative or past the end.
    ///
    /// The element leaves the list owned by the caller: reading it out and then
    /// releasing it here would free the value this returns.
    @index_bounds_check("index")
    public fn remove_at(index int) T?
        if index < 0: return None
        if index >= self.length(): return None
        let item = self[index]
        miri_rt_list_take_at(self, index)
        return item

    /// Removes the first occurrence of the given item from the list.
    /// Returns true if an item was removed, false otherwise.
    public fn remove(item T) bool
        let idx_opt = self.index_of(item)
        match idx_opt
            Some(idx)
                miri_rt_list_remove(self, idx)
                true
            None
                false

    /// Removes all elements from the list.
    public fn clear()
        miri_rt_list_clear(self)

    /// Sorts the list in ascending order.
    public fn sort()
        miri_rt_list_sort(self)

    /// Reverses the list in place.
    public fn reverse()
        miri_rt_list_reverse(self)

    /// Returns the index of the last element, or None if empty.
    public fn last_index() int?
        let len = self.length()
        if len > 0: return Some(len - 1)
        return None

    /// Returns a deep copy of this list.
    public fn clone() List<T>
        return miri_rt_list_clone(self)
