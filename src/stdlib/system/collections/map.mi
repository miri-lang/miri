use system.ops
use system.memory

/// A key-value collection where each key maps to a value.
///
/// Map<K, V> holds distinct keys with associated values, accessed by key using
/// `get()`, `set()`, and `remove()`. The iteration order is unspecified and must
/// not be relied upon; keys are accessed via `element_at()` and values via `value_at()`.
/// A repeated key keeps its most recent value. Maps are passed by reference, so
/// `set()` and `remove()` affect the original; use `clone()` for an independent copy.
///
/// Example:
///     var m = Map<String, int>()
///     m.set("alice", 30)
///     m.set("bob", 25)
///     let score = m.get("alice") ?? 0
///     println(f"{score}")                 // 30
///     println(f"{m.length()}")            // 2
public class Map<K, V> implements Iterable<K>, Cloneable

    @allocates
    runtime "core" fn miri_rt_map_new(key_size int, value_size int, key_kind int) Self
    @writes("m")
    runtime "core" fn miri_rt_map_free(m Self)
    @reads("m")
    runtime "core" fn miri_rt_map_len(m Self) int
    @writes("m")
    @key("key")
    @value("value")
    @stores("key, value")
    @matches("m")
    runtime "core" fn miri_rt_map_set(m Self, key K, value V)
    @reads("m")
    @key("key")
    @returns_element
    @matches("m")
    runtime "core" fn miri_rt_map_get(m Self, key K) V
    @reads("m")
    @key("key")
    @matches("m")
    runtime "core" fn miri_rt_map_contains_key(m Self, key K) bool
    @reads("m")
    @key("key")
    @matches("m")
    runtime "core" fn miri_rt_map_slot_of(m Self, key K) int
    @reads("m")
    @returns_element
    runtime "core" fn miri_rt_map_value_in_slot(m Self, slot int) V
    @writes("m")
    @key("key")
    @matches("m")
    runtime "core" fn miri_rt_map_remove(m Self, key K) bool
    @writes("m")
    runtime "core" fn miri_rt_map_clear(m Self)
    @reads("m")
    @returns_element
    runtime "core" fn miri_rt_map_key_at(m Self, index int) K
    @reads("m")
    @returns_element
    runtime "core" fn miri_rt_map_value_at(m Self, index int) V
    @reads("m")
    @copies("m")
    runtime "core" fn miri_rt_map_clone(m Self) Map<K, V>

    /// Returns the number of key-value pairs in the map.
    public fn length() int: miri_rt_map_len(self)

    /// Returns the key at the given sequential index.
    /// This enables for-loop iteration: `for k in map` or `for k, v in map`.
    public fn element_at(index int) K: miri_rt_map_key_at(self, index)

    /// Returns the value at the given sequential index.
    /// Used internally for `for k, v in map` iteration.
    public fn value_at(index int) V: miri_rt_map_value_at(self, index)

    /// Returns an iterator over the map's keys, in the map's unspecified
    /// order. The iterator walks the map as it is now: a later write to this
    /// map leaves the walk unchanged.
    public fn iterator() Iterator<K>
        return MapIterator<K, V>(source: self)

    /// Sets the value associated with the given key.
    public fn set(key K, value V)
        miri_rt_map_set(self, key, value)

    /// Returns the value associated with the given key, or None if the key is not in the map.
    public fn get(key K) V?
        let slot = miri_rt_map_slot_of(self, key)
        if slot < 0
            return None
        Some(miri_rt_map_value_in_slot(self, slot))

    /// Returns true if the map contains the given key.
    public fn contains_key(key K) bool: miri_rt_map_contains_key(self, key)

    /// Removes the entry with the given key.
    public fn remove(key K) bool: miri_rt_map_remove(self, key)

    /// Removes all entries from the map.
    public fn clear()
        miri_rt_map_clear(self)

    /// Returns true if the map has no entries.
    public fn is_empty() bool: self.length() == 0

    /// Returns a clone of this map with independent structural ownership.
    ///
    /// Adding or removing keys in the clone does not affect the original and vice versa.
    /// Primitive values (int, bool, float) and strings are independent copies.
    /// Custom class values that implement Cloneable are deep-copied via their clone() method.
    public fn clone() Map<K, V>
        return miri_rt_map_clone(self)

    /// Returns a new Map containing only entries for which `f` returns true.
    public fn filter(f fn(K, V) bool) {K: V}
        var result = Map<K, V>()
        var i = 0
        let n = self.length()
        while i < n
            let k = self.element_at(i)
            let v = self.value_at(i)
            if f(k, v)
                result.set(k, v)
            i += 1
        return result

    /// Returns a new Map with values transformed by `f` (keys unchanged).
    public fn map(f fn(K, V) V) {K: V}
        var result = Map<K, V>()
        var i = 0
        let n = self.length()
        while i < n
            let k = self.element_at(i)
            let v = self.value_at(i)
            result.set(k, f(k, v))
            i += 1
        return result

    /// Reduces all entries to a single value by applying `f` left-to-right.
    public fn reduce(init V, f fn(V, K, V) V) V
        var acc = init
        var i = 0
        let n = self.length()
        while i < n
            let k = self.element_at(i)
            let v = self.value_at(i)
            acc = f(acc, k, v)
            i += 1
        return acc

/// Hands out a map's keys one at a time, in the map's unspecified order.
///
/// `value` is the value of the key `next` last returned: `None` before the
/// first `next`, and `None` once `next` has returned `None`.
///
/// The iterator holds the map it walks. A map is a value, so a write to the
/// map the iterator came from, made during the walk, copies that map and
/// leaves the walk on the entries it started with.
public class MapIterator<K, V> implements Iterator<K>, Entries<V>
    private var source Map<K, V>
    private var slot int
    private var current int

    @reads("m")
    runtime "core" fn miri_rt_map_next_slot(m Map<K, V>, start int) int
    @reads("m")
    @returns_element
    runtime "core" fn miri_rt_map_key_in_slot(m Map<K, V>, slot int) K
    @reads("m")
    @returns_element
    runtime "core" fn miri_rt_map_value_in_slot(m Map<K, V>, slot int) V

    /// Starts a walk over `source` at its first slot.
    fn init(source Map<K, V>)
        self.source = source
        self.slot = 0
        self.current = -1

    /// Returns the next key, or `None` once every key has been returned.
    public fn next() K?
        let found = miri_rt_map_next_slot(self.source, self.slot)
        if found < 0
            self.current = -1
            return None
        self.current = found
        self.slot = found + 1
        return Some(miri_rt_map_key_in_slot(self.source, found))

    /// Returns the value of the key `next` last returned, or `None` when
    /// `next` has not returned a key.
    public fn value() V?
        if self.current < 0: return None
        return Some(miri_rt_map_value_in_slot(self.source, self.current))
