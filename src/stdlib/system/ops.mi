/// Operator traits for Miri.
///
/// These traits define the protocols for operator overloading:
/// - `Equatable`: enables `==` and `!=` operators
/// - `Comparable`: enables `<`, `<=`, `>` and `>=` operators
/// - `Steppable`: enables `for x in a..b` over a range of the type's values
/// - `Addable`: enables `+` operator (concatenation, combination, etc.)

/// Enables equality comparison (`==` and `!=`) for types that implement it.
///
/// The `!=` operator is automatically derived as the logical negation of `equals`.
///
/// Example:
///     class Point implements Equatable
///         x int
///         y int
///         public fn equals(other Self) bool
///             return self.x == other.x and self.y == other.y
public trait Equatable
    public fn equals(other Self) bool

/// Gives a type's values a hash consistent with its `equals`, which a Set
/// places its elements by and a Map its keys.
///
/// Two values `equals` calls equal must return the same hash; values that
/// are not equal should, but need not, return different ones. A type whose
/// equality is derived — a struct, an enum, a tuple of them — derives its hash
/// too, so only a type that writes its own `equals` writes `hash`, and such a
/// type is refused as a Set element or Map key until it does. `hash_combine`
/// folds the hashes of the fields `equals` compares into one.
///
/// Example:
///     class Point implements Equatable, Hashable
///         x int
///         y int
///         label String
///         public fn equals(other Self) bool
///             return self.x == other.x and self.y == other.y
///         public fn hash() int
///             return hash_combine(self.x.hash(), self.y.hash())
public trait Hashable
    public fn hash() int

runtime "core" fn miri_rt_hash_combine(seed int, value int) int

/// `seed` with `value` mixed into it, so a hash built from several parts
/// depends on every part and on their order.
public fn hash_combine(seed int, value int) int
    return miri_rt_hash_combine(seed, value)

/// Enables ordering comparison (`<`, `<=`, `>`, `>=`) for types that implement it.
///
/// `compare` returns a negative number when `self` sorts before `other`, zero
/// when neither sorts before the other, and a positive number when `self` sorts
/// after `other`. Each operator is derived by comparing that result against
/// zero, so a type that orders its values defines one method rather than four.
///
/// Ordering is deliberately separate from equality: a type may know when two of
/// its values are the same without knowing which of them comes first.
///
/// Example:
///     class Weight implements Comparable
///         grams int
///         public fn compare(other Self) int
///             return self.grams - other.grams
public trait Comparable
    public fn compare(other Self) int

/// Enables `for x in a..b` and `for x in a..=b` over a range of the type's
/// values.
///
/// The loop starts at `a` and asks `successor` for each next value. It runs
/// while the value sorts before the end, by the `compare` the type's
/// `Comparable` implementation supplies, and an inclusive range leaves once it
/// has run at the end, so no successor of the end is ever asked for. Before
/// the first pass the loop asks `steppable` of both bounds; a bound for which
/// it is false stops the program (MER_RT_019). A type whose every value can
/// start or end a range keeps the default, which is `true`.
///
/// The integers meet this trait without declaring it, and `String` implements
/// it for one-character strings, which step by Unicode code point.
///
/// Example:
///     class Day implements Steppable
///         number int
///         public fn compare(other Self) int
///             return self.number - other.number
///         public fn successor() Self
///             return Day(self.number + 1)
///
///     for day in Day(1)..=Day(7)
///         println(f"{day.number}")
public trait Steppable extends Comparable
    public fn successor() Self

    public fn steppable() bool
        return true

/// Enables the `+` operator for types that implement it.
///
/// Example:
///     class Vector implements Addable
///         x int
///         public fn concat(other Self) Self
///             return Vector(self.x + other.x)
public trait Addable
    public fn concat(other Self) Self

/// Enables the `*` operator for repetition.
///
/// Example:
///     class Pattern implements Multiplicable
///         let value String
///         public fn repeat(count int) Self
///             return Pattern(self.value * count)
public trait Multiplicable
    public fn repeat(count int) Self

/// Enables for-loop iteration over a type.
///
/// Types implementing this trait can be used in `for x in collection` loops.
/// The iterator protocol uses index-based access via `element_at` and `length`.
/// The element type `T` is the type yielded by each iteration step — `Iterable<int>`
/// produces ints, `Iterable<String>` produces strings, etc.
///
/// Example:
///     for ch in "hello"        // String implements Iterable<String>
///         println(ch)          // each ch is a one-character String
public trait Iterable<T>
    public fn length() int
    public fn element_at(index int) T

/// Hands out the elements of a sequence one at a time.
///
/// Each `next` returns the next element, or `None` once every element has
/// been handed out; from then on it keeps returning `None`.
///
/// Example:
///     let it = {1, 2, 3}.iterator()
///     while true
///         match it.next()
///             Some(x): println(f"{x}")
///             None: break
public trait Iterator<T>
    public fn next() T?

/// The value that goes with the element an iterator's `next` most recently
/// returned: a map's value for the key, a list's index for the element.
///
/// `value` is `None` before the first `next`, and `None` again once `next`
/// has returned `None`, since no element was returned then.
public trait Entries<V>
    public fn value() V?

/// A sequence read by position: `length` elements, the one at each index
/// from 0 up to `length() - 1` read by `element_at`.
///
/// The default `iterator` walks the sequence by position with an
/// `IndexIterator`.
///
/// Example:
///     class Squares implements Indexed<int>
///         var count int
///         fn init(count int)
///             self.count = count
///         public fn length() int: self.count
///         public fn element_at(index int) int: index * index
public trait Indexed<T>
    public fn length() int
    public fn element_at(index int) T

    /// Returns an iterator over the elements, from index 0 upward.
    public fn iterator() Iterator<T>
        return IndexIterator<T, Self>(source: self)

/// Walks an `Indexed` source by position, from index 0 up to the last index.
///
/// The iterator holds the source it walks. A collection is a value, so a write
/// to the collection the iterator was made from, made during the walk, copies
/// that collection and leaves the walk on the elements it started with.
///
/// `value` is the index of the element `next` last returned: `None` before
/// the first `next`, and `None` once `next` has returned `None`.
///
/// Example:
///     let it = IndexIterator<String, List<String>>(source: List(["a", "b"]))
///     while true
///         match it.next()
///             Some(x): println(f"{it.value() ?? -1} {x}")
///             None: break
public class IndexIterator<T, S implements Indexed<T>> implements Iterator<T>, Entries<int>
    private var source S
    private var next_index int
    private var current int

    /// Starts a walk over `source` at its first element.
    fn init(source S)
        self.source = source
        self.next_index = 0
        self.current = -1

    /// Returns the element at the next index, or `None` past the last one.
    public fn next() T?
        if self.next_index >= self.source.length()
            self.current = -1
            return None
        self.current = self.next_index
        self.next_index += 1
        return Some(self.source.element_at(self.current))

    /// Returns the index of the element `next` last returned, or `None` when
    /// `next` has not returned an element.
    public fn value() int?
        if self.current < 0: return None
        return Some(self.current)
