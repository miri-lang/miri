use system.ops
use system.memory

/// A UTF-8 encoded string type.
///
/// Strings in Miri are immutable sequences of Unicode characters.
/// All operations that modify a string return a new string instance.
public class String implements Equatable, Hashable, Comparable, Addable, Multiplicable, Iterable<String>, Cloneable

    // Intrinsic function declarations
    // These map to miri_rt_* functions in the Rust runtime.

    runtime "core" fn miri_rt_string_new() String

    runtime "core" fn miri_rt_string_len(s String) int
    runtime "core" fn miri_rt_string_char_count(s String) int
    runtime "core" fn miri_rt_string_is_empty(s String) bool
    runtime "core" fn miri_rt_string_concat(left String, right String) String
    runtime "core" fn miri_rt_string_to_lower(s String) String
    runtime "core" fn miri_rt_string_to_upper(s String) String
    runtime "core" fn miri_rt_string_trim(s String) String
    runtime "core" fn miri_rt_string_trim_start(s String) String
    runtime "core" fn miri_rt_string_trim_end(s String) String
    runtime "core" fn miri_rt_string_contains(haystack String, needle String) bool
    runtime "core" fn miri_rt_string_starts_with(s String, prefix String) bool
    runtime "core" fn miri_rt_string_ends_with(s String, suffix String) bool
    runtime "core" fn miri_rt_string_replace(s String, old String, to String) String
    runtime "core" fn miri_rt_string_substring(s String, start int, end int) String
    runtime "core" fn miri_rt_string_equals(a String, b String) bool
    runtime "core" fn miri_rt_string_compare(a String, b String) int
    runtime "core" fn miri_rt_string_hash(s String) int
    runtime "core" fn miri_rt_string_clone(s String) String
    runtime "core" fn miri_rt_string_free(s String)
    runtime "core" fn miri_rt_string_repeat(s String, count int) String
    runtime "core" fn miri_rt_string_char_at(s String, index int) String
    runtime "core" fn miri_rt_string_split(s String, separator String) [String]
    runtime "core" fn miri_rt_string_join(separator String, parts [String]) String
    runtime "core" fn miri_rt_string_parse_int(s String) int
    runtime "core" fn miri_rt_string_parse_int_status() int
    runtime "core" fn miri_rt_string_parse_float(s String) float
    runtime "core" fn miri_rt_string_parse_float_status() int
    runtime "core" fn miri_rt_string_next_char_boundary(s String, byte_pos int) int
    runtime "core" fn miri_rt_string_code_at(s String, index int) int
    runtime "core" fn miri_rt_string_index_of_any(s String, chars String, start int) int
    runtime "core" fn miri_rt_string_from_code_point(code int) String

    // Constructors

    /// Creates a new empty string.
    fn init() String
        self = miri_rt_string_new()

    // Properties

    /// Returns the number of Unicode characters in the string.
    ///
    /// The first call counts the string in O(n); the count is remembered, so a
    /// loop that asks again each pass pays for it once.
    public fn length() int: miri_rt_string_char_count(self)
        
    /// Returns the byte length of the string.
    public fn size() int: miri_rt_string_len(self)

    /// Returns true if the string has no characters.
    public fn is_empty() bool: miri_rt_string_is_empty(self)

    // Transformations (return new strings)

    /// Returns a new string with all characters converted to lowercase.
    public fn to_lower() String
        return miri_rt_string_to_lower(self)

    /// Returns a new string with all characters converted to uppercase.
    public fn to_upper() String
        return miri_rt_string_to_upper(self)

    /// Returns a new string with leading and trailing whitespace removed.
    public fn trim() String
        return miri_rt_string_trim(self)

    /// Returns a new string with leading whitespace removed.
    public fn trim_start() String
        return miri_rt_string_trim_start(self)

    /// Returns a new string with trailing whitespace removed.
    public fn trim_end() String
        return miri_rt_string_trim_end(self)

    /// Returns a new string with all occurrences of `from` replaced with `to`.
    public fn replace(old String, to String) String
        return miri_rt_string_replace(self, old, to)

    /// Returns the characters from index `start` to `end` (exclusive), counted
    /// the way `length()`, `element_at()` and `code_at()` count them, so
    /// `s.substring(1, s.length())` drops the first character of any text.
    ///
    /// An index outside `0 <= start <= end <= length()` stops the program with
    /// an index-out-of-bounds error; when the text and both indices are
    /// constants, the compiler reports it instead.
    ///
    /// Example:
    ///     "héllo".substring(1, 4) → "éll"
    @index_range_check("start, end")
    public fn substring(start int, end int) String
        return miri_rt_string_substring(self, start, end)

    // Search and comparison

    /// Returns true if this string contains the given substring.
    public fn contains(needle String) bool
        return miri_rt_string_contains(self, needle)

    /// Returns true if this string starts with the given prefix.
    public fn starts_with(prefix String) bool
        return miri_rt_string_starts_with(self, prefix)

    /// Returns true if this string ends with the given suffix.
    public fn ends_with(suffix String) bool
        return miri_rt_string_ends_with(self, suffix)

    /// Returns the character index of the first character at or after `start`
    /// that is one of the characters of `chars`, or None if there is none.
    ///
    /// Indices are CHARACTER indices, as in `code_at()` and `substring()`. Like
    /// `code_at()`, an index outside the text is not an error: a negative
    /// `start`, or one at or past `length()`, returns None, as does an empty
    /// `chars`. A search that resumes from the last match plus one walks the
    /// text once in total.
    ///
    /// Example:
    ///     "key=value; next".index_of_any("=;", 0) → Some(3)
    ///     "key=value; next".index_of_any("=;", 4) → Some(9)
    ///     "café au lait".index_of_any(" ", 0) → Some(4)
    ///     "café".index_of_any("é", 0) → Some(3)
    ///     "hello".index_of_any("xyz", 0) → None
    ///     "hello".index_of_any("h", -1) → None
    public fn index_of_any(chars String, start int) int?
        let index = miri_rt_string_index_of_any(self, chars, start)
        if index < 0
            None
        else
            Some(index)

    /// Returns true if this string is equal to another string.
    public fn equals(other String) bool
        return miri_rt_string_equals(self, other)

    /// A hash of this string's content: equal strings hash alike.
    public fn hash() int
        return miri_rt_string_hash(self)

    /// Orders this string against another by content.
    ///
    /// Returns a negative number when this string sorts first, zero when the
    /// two are equal, and a positive number when this string sorts last.
    /// Ordering is by Unicode code point, so every uppercase ASCII letter
    /// sorts before every lowercase one.
    ///
    /// This is used by the `<`, `<=`, `>` and `>=` operators.
    ///
    /// Example:
    ///     "apple".compare("banana") → -1
    ///     "apple".compare("apple") → 0
    ///     "apple".compare("Apple") → 1
    public fn compare(other String) int
        return miri_rt_string_compare(self, other)

    // Operators

    /// Concatenates this string with another.
    ///
    /// This is used by the `+` operator: `"hello" + " world"`.
    public fn concat(other String) String
        return miri_rt_string_concat(self, other)

    /// Repeats this string a given number of times.
    ///
    /// This is used by the `*` operator: `"ha" * 3` → `"hahaha"`.
    public fn repeat(count int) String
        return miri_rt_string_repeat(self, count)

    /// Returns the character at the given index as a string.
    ///
    /// This enables for-loop iteration: `for ch in "hello"`.
    public fn element_at(index int) String
        return miri_rt_string_char_at(self, index)

    /// Splits the string at each occurrence of the separator substring.
    ///
    /// Separators are removed from the result. Empty fields are preserved.
    /// If the separator is not found, returns a list with one element: the original string.
    /// An empty separator splits into individual characters.
    /// An empty string splits into a list with one empty string element.
    ///
    /// Example:
    ///     "a,b,c".split(",") → ["a", "b", "c"]
    ///     "a,,b".split(",") → ["a", "", "b"]
    ///     "abc".split("") → ["a", "b", "c"]
    ///     "".split(",") → [""]
    public fn split(separator String) [String]
        return miri_rt_string_split(self, separator)

    /// The pieces `split(separator)` would return, one at a time.
    ///
    /// The pieces are found as they are read rather than built into a list up
    /// front, so walking the pieces of a large text holds one piece at a time.
    /// Reading them in order costs one pass over the text, plus one to count
    /// them the first time `length()` is asked. Each piece read is a new string.
    ///
    /// Example:
    ///     for field in "a,,b".pieces(",")   // "a", "", "b"
    ///         println(field)
    public fn pieces(separator String) StringPieces
        return StringPieces(source: self, separator: separator, is_lines: false)

    /// The lines of the string, one at a time.
    ///
    /// A line ends at `"\n"`, and a `"\r"` just before that `"\n"` is dropped,
    /// so `"\r\n"` endings read like `"\n"` ones. The final `"\n"` ends the
    /// last line rather than starting an empty one, and an empty string has no
    /// lines. This differs from `split("\n")` in exactly those three places:
    /// `"a\n"` gives one line but splits into `["a", ""]`; `"a\r\nb"` gives
    /// `"a"` but splits into `"a\r"`; `""` gives no lines but splits into `[""]`.
    /// A `"\r"` anywhere else stays part of its line.
    ///
    /// Lines are found as they are read, as with `pieces`.
    ///
    /// Example:
    ///     "one\r\ntwo\n".lines()   // "one", "two"
    ///     "a\n\nb".lines()         // "a", "", "b"
    public fn lines() StringPieces
        return StringPieces(source: self, separator: "\n", is_lines: true)

    /// Joins the elements of a list with this string as the separator.
    ///
    /// This is the inverse of split. The receiver is the separator (Python-style).
    /// An empty list returns an empty string.
    /// A single-element list returns that element unchanged.
    ///
    /// Note: This method deviates from PRINCIPLES.md §12 R1 ("operation on T is a method on T")
    /// because Miri's trait system cannot constrain a `List<T>` method to `T = String`.
    /// The practical consequence: join() is a method on the separator, not on the list.
    ///
    /// Example:
    ///     ",".join(["a", "b", "c"]) → "a,b,c"
    ///     ",".join([]) → ""
    ///     "".join(["a", "b"]) → "ab"
    public fn join(parts [String]) String
        return miri_rt_string_join(self, parts)

    /// Parses the string as an integer.
    ///
    /// Returns Some(n) if the string is a valid integer in decimal notation.
    /// Returns None if the string is empty, contains non-numeric characters (except
    /// a leading minus sign), or the value overflows/underflows an int.
    ///
    /// Whitespace is NOT automatically trimmed. Use .trim() if trimming is needed.
    ///
    /// Example:
    ///     "42".to_int() → Some(42)
    ///     "-42".to_int() → Some(-42)
    ///     "".to_int() → None
    ///     "  42  ".to_int() → None
    ///     "not a number".to_int() → None
    public fn to_int() int?
        let value = miri_rt_string_parse_int(self)
        let status = miri_rt_string_parse_int_status()
        if status == 0
            Some(value)
        else
            None

    /// Parses the string as a floating-point number.
    ///
    /// Returns Some(f) if the string is a valid floating-point literal in IEEE notation.
    /// The input may include special values: "inf", "infinity", "NaN", and overflowing
    /// magnitudes that round to infinity per IEEE 754 rules.
    /// Returns None if the string is empty, contains non-numeric characters (except
    /// a leading minus sign, decimal point, 'e'/'E', or special literals), or cannot
    /// be parsed as a valid float.
    ///
    /// Whitespace is NOT automatically trimmed. Use .trim() if trimming is needed.
    ///
    /// Example:
    ///     "3.14".to_float() → Some(3.14)
    ///     "42".to_float() → Some(42.0)
    ///     "-3.14".to_float() → Some(-3.14)
    ///     "1e400".to_float() → Some(inf)
    ///     "NaN".to_float() → Some(NaN)
    ///     "".to_float() → None
    ///     "  3.14  ".to_float() → None
    public fn to_float() float?
        let value = miri_rt_string_parse_float(self)
        let status = miri_rt_string_parse_float_status()
        if status == 0
            Some(value)
        else
            None

    /// Returns the Unicode scalar value (code point) at a character index.
    ///
    /// The index is a CHARACTER index, not a byte index, consistent with `length()` and `element_at()`.
    /// Returns None if the index is negative or >= length().
    ///
    /// Example:
    ///     "hello".code_at(0) → Some(104)  // 'h'
    ///     "café".code_at(3) → Some(233)   // 'é'
    ///     "hello".code_at(10) → None
    ///     "hello".code_at(-1) → None
    public fn code_at(index int) int?
        let code = miri_rt_string_code_at(self, index)
        if code < 0
            None
        else
            Some(code)

    /// Constructs a string from a Unicode scalar value (code point).
    ///
    /// Returns Some(s) if the code point is valid (non-negative, not a surrogate, <= 0x10FFFF).
    /// Returns None for invalid code points.
    ///
    /// Example:
    ///     String.from_code_point(65) → Some("A")
    ///     String.from_code_point(233) → Some("é")
    ///     String.from_code_point(0xD800) → None  // Surrogate
    ///     String.from_code_point(0x110000) → None  // Above max
    ///     String.from_code_point(-1) → None
    public static fn from_code_point(code int) String?
        // The intrinsic signals an invalid scalar value with an empty string.
        // That is unambiguous: every valid scalar value, including 0, encodes
        // to at least one byte.
        let s = miri_rt_string_from_code_point(code)
        if s.is_empty()
            None
        else
            Some(s)

    // Internal

    /// Returns a clone of this string.
    public fn clone() String
        return miri_rt_string_clone(self)

/// The pieces of a string between the occurrences of a separator, or its
/// lines, read one at a time: what `String.pieces` and `String.lines` return.
///
/// Holds the string it reads and the place of the last piece read, so reading
/// the pieces in order resumes where the previous one ended and walks the text
/// once. Reading an earlier piece walks again from the start. The number of
/// pieces is counted the first time `length()` is asked and remembered.
///
/// An index outside `0 <= index < length()` stops the program with the
/// index-out-of-bounds error list indexing reports.
///
/// Example:
///     let fields = "x=1;y=2".pieces(";")
///     println(fields.element_at(1))   // y=2
///     println(f"{fields.length()}")   // 2
public class StringPieces implements Iterable<String>
    private var source String
    private var separator String
    /// The separator's byte length: how far the next piece starts past the
    /// end of the last.
    private var step int
    private var is_lines bool
    /// The number of pieces, or -1 until it is first asked for.
    private var count int
    /// The index of the next piece in order, and the byte where it starts.
    private var cursor_index int
    private var cursor_byte int

    runtime "core" fn miri_rt_string_piece_count(s String, separator String) int
    runtime "core" fn miri_rt_string_line_count(s String) int
    runtime "core" fn miri_rt_string_piece_end(s String, separator String, start int) int
    runtime "core" fn miri_rt_string_slice_bytes(s String, start int, end int) String
    runtime "core" fn miri_rt_string_line_text(s String, start int, end int) String
    runtime "core" fn miri_rt_string_piece_index(index int, count int) int

    fn init(source String, separator String, is_lines bool)
        self.source = source
        self.step = separator.size()
        self.separator = separator
        self.is_lines = is_lines
        self.count = -1
        self.cursor_index = 0
        self.cursor_byte = 0

    /// How many pieces there are.
    public fn length() int
        if self.count < 0
            if self.is_lines
                self.count = miri_rt_string_line_count(self.source)
            else
                self.count = miri_rt_string_piece_count(self.source, self.separator)
        self.count

    /// The piece at `index`, as a new string.
    ///
    /// This enables for-loop iteration: `for line in text.lines()`.
    public fn element_at(index int) String
        let wanted = miri_rt_string_piece_index(index, self.length())
        if wanted < self.cursor_index
            self.cursor_index = 0
            self.cursor_byte = 0
        while self.cursor_index < wanted
            self.cursor_byte = self.end_of_piece() + self.step
            self.cursor_index += 1
        let start = self.cursor_byte
        let end = self.end_of_piece()
        self.cursor_byte = end + self.step
        self.cursor_index = wanted + 1
        if self.is_lines
            return miri_rt_string_line_text(self.source, start, end)
        miri_rt_string_slice_bytes(self.source, start, end)

    /// The byte where the piece starting at the cursor ends.
    private fn end_of_piece() int
        miri_rt_string_piece_end(self.source, self.separator, self.cursor_byte)
