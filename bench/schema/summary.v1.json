{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "summary.v1.json",
  "title": "Benchmark summary, schema version 1",
  "description": "What bench/summarize.py writes and the charts and website read. Every ratio and verdict is computed by bench/summarize.py under bench/CHARTER.md section 6.",
  "type": "object",
  "required": ["schema_version", "charter_version", "charter_hash", "run_id", "machine_profile", "provenance", "cells", "aggregates"],
  "properties": {
    "schema_version": {"const": 1},
    "charter_version": {"type": "integer"},
    "charter_hash": {"type": "string"},
    "run_id": {"type": "string"},
    "machine_profile": {"enum": ["dev", "ci-smoke", "publication", "preliminary-vps"]},
    "provenance": {"type": "object"},
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workload", "language", "variant", "size", "mode", "status"],
        "properties": {
          "workload": {"type": "string"},
          "language": {"type": "string"},
          "variant": {"enum": ["default", "native"]},
          "size": {"enum": ["s", "m", "l"]},
          "mode": {"enum": ["cold", "hot"]},
          "status": {"enum": ["ok", "noisy", "timeout", "mismatch", "build-failed", "toolchain-missing", "unsupported"]},
          "attempts": {"type": "integer"},
          "metrics": {
            "type": "object",
            "properties": {
              "process_wall_ns": {"$ref": "#/$defs/statistics"},
              "user_ns": {"$ref": "#/$defs/statistics"},
              "sys_ns": {"$ref": "#/$defs/statistics"},
              "max_rss_bytes": {"$ref": "#/$defs/statistics"},
              "hot_ns": {"$ref": "#/$defs/statistics"},
              "net_rss_bytes": {
                "type": "object",
                "required": ["value", "at_or_below_floor"],
                "properties": {"value": {"type": ["number", "null"]}, "at_or_below_floor": {"type": "boolean"}}
              }
            }
          },
          "vs_c": {"type": "object"},
          "vs_miri": {"type": "object"},
          "vs_rust": {"type": "object"},
          "diagnose": {"type": "boolean"},
          "steal_share": {"description": "The share of the cell's CPU time the hypervisor took from the pinned core.", "type": "number"},
          "reproduced": {"description": "Whether the cell's ratio to C agrees with the first session's under the verdict rule; present only on a second session.", "type": "boolean"}
        }
      }
    },
    "aggregates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "variant", "size", "mode", "tag", "geomean_vs_c", "coverage"],
        "properties": {
          "language": {"type": "string"},
          "variant": {"type": "string"},
          "size": {"type": "string"},
          "mode": {"type": "string"},
          "tag": {"type": "string"},
          "geomean_vs_c": {"type": "number"},
          "coverage": {"type": "integer"},
          "geomean_max_rss_vs_c": {"type": "number"},
          "memory_coverage": {"type": "integer"}
        }
      }
    },
    "compile": {
      "description": "Per workload and optimisation level (opt3, opt0), the best of the Miri port's timed builds: wall time and the compiler's peak resident memory. For awareness; nothing is gated on it.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["wall_ns", "max_rss_bytes", "runs"],
          "properties": {"wall_ns": {"type": "integer"}, "max_rss_bytes": {"type": "integer"}, "runs": {"type": "integer"}}
        }
      }
    },
    "label": {"description": "The label a publishable profile's charts carry, such as preliminary; null otherwise.", "type": ["string", "null"]},
    "max_steal_share": {"description": "The largest steal share of any cell in the run; null where steal time was not read.", "type": ["number", "null"]},
    "reproduction": {
      "description": "A second session's agreement with the first: which run it reproduces, how many cells agree and disagree, and the largest drift of a ratio to C.",
      "type": "object",
      "required": ["of", "agreeing", "disagreeing", "max_drift"],
      "properties": {"of": {"type": "string"}, "agreeing": {"type": "integer"}, "disagreeing": {"type": "integer"}, "max_drift": {"type": "number"}}
    },
    "explanations": {
      "description": "Each measured cell's reason for where its language lands, by workload and then language, from the workload manifest's explain table.",
      "type": "object",
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}
    },
    "port_notes": {
      "description": "Each measured workload's manifest notes: what a reader needs beside its ratios to read them fairly, such as a reference port's known handicap.",
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    }
  },
  "$defs": {
    "statistics": {
      "type": "object",
      "required": ["n", "median", "min", "p_high", "mad", "cv"],
      "properties": {
        "n": {"type": "integer"},
        "median": {"type": "number"},
        "min": {"type": "number"},
        "p_high": {"type": "number"},
        "mad": {"type": "number"},
        "cv": {"type": "number"}
      }
    }
  }
}
