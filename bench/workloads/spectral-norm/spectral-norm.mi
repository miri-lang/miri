// spectral-norm: the largest eigenvalue of an infinite matrix, by power
// iteration on its first n rows. Stresses float arithmetic, a small function
// called in the inner loop, and list reads.

use system.io
use system.fs
use system.os
use system.time
use system.process
use system.math
use system.collections.list

fn entry(i int, j int) float
    1.0 / (((i + j) * (i + j + 1) / 2 + i + 1) as float)

fn times(v [float]) [float]
    let n = v.length()
    var out = List<float>()
    var i = 0
    while i < n
        var sum = 0.0
        var j = 0
        while j < n
            sum = sum + entry(i, j) * v[j]
            j += 1
        out.push(sum)
        i += 1
    out

fn times_transposed(v [float]) [float]
    let n = v.length()
    var out = List<float>()
    var i = 0
    while i < n
        var sum = 0.0
        var j = 0
        while j < n
            sum = sum + entry(j, i) * v[j]
            j += 1
        out.push(sum)
        i += 1
    out

fn times_both(v [float]) [float]: times_transposed(times(v))

/// Ten rounds of power iteration on the first `n` rows; the estimate in
/// billionths, truncated toward zero.
fn kernel(n int) String
    var u = List<float>()
    var i = 0
    while i < n
        u.push(1.0)
        i += 1
    var v = List<float>()
    var round = 0
    while round < 10
        v = times_both(u)
        u = times_both(v)
        round += 1
    var vbv = 0.0
    var vv = 0.0
    i = 0
    while i < n
        vbv = vbv + u[i] * v[i]
        vv = vv + v[i] * v[i]
        i += 1
    f"{(sqrt(vbv / vv) * 1000000000.0) as int}"

/// The integer in the file at `path`; a missing file or anything else in it
/// ends the program with status 2, as in every other port.
fn read_parameter(path String) int
    let fs = Fs()
    match fs.read_file(path)
        Result.Ok(text)
            match text.trim().to_int()
                Some(n): return n
                None
                    exit(2)
                    return 0
        Result.Err(_)
            exit(2)
            return 0

/// Run the kernel untimed and then timed, report each timed iteration on
/// stderr, and refuse to print a checksum any iteration disagrees with.
fn run_hot(n int) String
    let clock = Clock()
    let expected = kernel(n)
    var agree = true
    var i = 1
    while i < 5
        if kernel(n) != expected
            agree = false
        i += 1
    i = 0
    while i < 5
        let start = clock.now()
        let checksum = kernel(n)
        let elapsed = start.elapsed(clock).as_nanos()
        eprintln(f"hot_ns={elapsed}")
        if checksum != expected
            agree = false
        i += 1
    if not agree
        eprintln("checksum differs between iterations")
        exit(1)
    expected

let args = Args()
let n = read_parameter(args.element_at(0))
if args.length() > 1 and args.element_at(1) == "hot"
    println(run_hot(n))
else
    println(kernel(n))
