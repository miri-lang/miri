// fannkuch-redux: every permutation of 1..n, counting the prefix reversals
// ("pancake flips") each needs before 1 reaches the front. Stresses integer
// list reads and writes, swaps and short inner loops.

use system.io
use system.fs
use system.os
use system.time
use system.process
use system.collections.list

/// The alternating checksum over every permutation of 0..n-1 in the
/// benchmark's counting order, and the most flips any permutation needs.
fn kernel(n int) String
    var perm = List<int>()
    var count = List<int>()
    var scratch = List<int>()
    var i = 0
    while i < n
        perm.push(i)
        count.push(0)
        scratch.push(0)
        i += 1
    var checksum = 0
    var max_flips = 0
    var index = 0
    var done = false
    while not done
        var k = 0
        while k < n
            scratch[k] = perm[k]
            k += 1
        var flips = 0
        var first = scratch[0]
        while first != 0
            var lo = 0
            var hi = first
            while lo < hi
                let t = scratch[lo]
                scratch[lo] = scratch[hi]
                scratch[hi] = t
                lo += 1
                hi -= 1
            flips += 1
            first = scratch[0]
        if flips > max_flips
            max_flips = flips
        if index % 2 == 0
            checksum += flips
        else
            checksum -= flips
        index += 1
        var r = 1
        var advanced = false
        while r < n and not advanced
            let head = perm[0]
            k = 0
            while k < r
                perm[k] = perm[k + 1]
                k += 1
            perm[r] = head
            count[r] = count[r] + 1
            if count[r] <= r
                advanced = true
            else
                count[r] = 0
                r += 1
        if not advanced
            done = true
    f"{checksum} {max_flips}"

/// The integer in the file at `path`; a missing file or anything else in it
/// ends the program with status 2, as in every other port.
fn read_parameter(path String) int
    let fs = Fs()
    match fs.read_file(path)
        Result.Ok(text)
            match text.trim().to_int()
                Some(n): return n
                None
                    exit(2)
                    return 0
        Result.Err(_)
            exit(2)
            return 0

/// Run the kernel untimed and then timed, report each timed iteration on
/// stderr, and refuse to print a checksum any iteration disagrees with.
fn run_hot(n int) String
    let clock = Clock()
    let expected = kernel(n)
    var agree = true
    var i = 1
    while i < 5
        if kernel(n) != expected
            agree = false
        i += 1
    i = 0
    while i < 5
        let start = clock.now()
        let checksum = kernel(n)
        let elapsed = start.elapsed(clock).as_nanos()
        eprintln(f"hot_ns={elapsed}")
        if checksum != expected
            agree = false
        i += 1
    if not agree
        eprintln("checksum differs between iterations")
        exit(1)
    expected

let args = Args()
let n = read_parameter(args.element_at(0))
if args.length() > 1 and args.element_at(1) == "hot"
    println(run_hot(n))
else
    println(kernel(n))
