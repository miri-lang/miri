// csv-aggregate: read a generated CSV file, split each line, parse its
// numbers, and total them by key. Stresses string splitting, number parsing
// and a string-keyed map: the everyday script.

use system.io
use system.fs
use system.os
use system.time
use system.process
use system.collections.list
use system.collections.map

struct Totals
    count int
    quantity int
    amount float

/// Group the records by region: how many, their quantities and their amounts
/// summed, every region in order.
fn kernel(text String) String
    var groups = Map<String, Totals>()
    var first = true
    for line in text.lines()
        if first or line == ""
            first = false
            continue
        let fields = line.split(",")
        let quantity = fields[1].to_int() ?? 0
        let amount = fields[2].to_float() ?? 0.0
        let before = groups.get(fields[0]) ?? Totals(count: 0, quantity: 0, amount: 0.0)
        groups[fields[0]] = Totals(count: before.count + 1, quantity: before.quantity + quantity, amount: before.amount + amount)
    var keys = List<String>()
    var i = 0
    while i < groups.length()
        keys.push(groups.element_at(i))
        i += 1
    keys.sort()
    var parts = List<String>()
    for key in keys
        let t = groups.get(key) ?? Totals(count: 0, quantity: 0, amount: 0.0)
        parts.push(f"{key}:{t.count}:{t.quantity}:{(t.amount * 100.0) as int}")
    ",".join(parts)

/// The whole file at `path`; a missing file ends the program with status 2,
/// as in every other port.
fn read_input(path String) String
    let fs = Fs()
    match fs.read_file(path)
        Result.Ok(text): return text
        Result.Err(_)
            exit(2)
            return ""

/// Run the kernel untimed and then timed, report each timed iteration on
/// stderr, and refuse to print a checksum any iteration disagrees with.
fn run_hot(input String) String
    let clock = Clock()
    let expected = kernel(input)
    var agree = true
    var i = 1
    while i < 5
        if kernel(input) != expected
            agree = false
        i += 1
    i = 0
    while i < 5
        let start = clock.now()
        let checksum = kernel(input)
        let elapsed = start.elapsed(clock).as_nanos()
        eprintln(f"hot_ns={elapsed}")
        if checksum != expected
            agree = false
        i += 1
    if not agree
        eprintln("checksum differs between iterations")
        exit(1)
    expected

let args = Args()
let input = read_input(args.element_at(0))
if args.length() > 1 and args.element_at(1) == "hot"
    println(run_hot(input))
else
    println(kernel(input))
