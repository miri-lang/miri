// matmul: the naive triple loop multiplying two n by n matrices held as
// lists of rows. Stresses float multiply-add, nested list reads and the cache.
// Every entry is a small whole number, so every sum is exact and every
// language computes the same bits.

use system.io
use system.fs
use system.os
use system.time
use system.process
use system.collections.list

fn matrix(n int, offset int) [[float]]
    var rows = List<[float]>()
    rows.reserve(n)
    var i = 0
    while i < n
        var row = List<float>()
        row.reserve(n)
        var j = 0
        while j < n
            row.push(((i * j + offset * (i + j)) % 10) as float)
            j += 1
        rows.push(row)
        i += 1
    rows

/// The sum of every entry of the product of two `n` by `n` matrices.
fn kernel(n int) String
    let a = matrix(n, 1)
    let b = matrix(n, 2)
    var total = 0.0
    var i = 0
    while i < n
        let row = a[i]
        var j = 0
        while j < n
            var sum = 0.0
            var k = 0
            while k < n
                sum = sum + row[k] * b[k][j]
                k += 1
            total = total + sum
            j += 1
        i += 1
    f"{total as int}"

/// The integer in the file at `path`; a missing file or anything else in it
/// ends the program with status 2, as in every other port.
fn read_parameter(path String) int
    let fs = Fs()
    match fs.read_file(path)
        Result.Ok(text)
            match text.trim().to_int()
                Some(n): return n
                None
                    exit(2)
                    return 0
        Result.Err(_)
            exit(2)
            return 0

/// Run the kernel untimed and then timed, report each timed iteration on
/// stderr, and refuse to print a checksum any iteration disagrees with.
fn run_hot(n int) String
    let clock = Clock()
    let expected = kernel(n)
    var agree = true
    var i = 1
    while i < 5
        if kernel(n) != expected
            agree = false
        i += 1
    i = 0
    while i < 5
        let start = clock.now()
        let checksum = kernel(n)
        let elapsed = start.elapsed(clock).as_nanos()
        eprintln(f"hot_ns={elapsed}")
        if checksum != expected
            agree = false
        i += 1
    if not agree
        eprintln("checksum differs between iterations")
        exit(1)
    expected

let args = Args()
let n = read_parameter(args.element_at(0))
if args.length() > 1 and args.element_at(1) == "hot"
    println(run_hot(n))
else
    println(kernel(n))
