// ray-tracer: trace a small scene of spheres one ray per pixel, shading each
// hit by the angle to a light. Stresses float arithmetic on small structs and
// function calls.

use system.io
use system.fs
use system.os
use system.time
use system.process
use system.math
use system.collections.list

struct Vec3
    x float
    y float
    z float

struct Sphere
    center Vec3
    radius float

fn add(a Vec3, b Vec3) Vec3: Vec3(x: a.x + b.x, y: a.y + b.y, z: a.z + b.z)

fn sub(a Vec3, b Vec3) Vec3: Vec3(x: a.x - b.x, y: a.y - b.y, z: a.z - b.z)

fn scale(a Vec3, k float) Vec3: Vec3(x: a.x * k, y: a.y * k, z: a.z * k)

fn dot(a Vec3, b Vec3) float: a.x * b.x + a.y * b.y + a.z * b.z

fn normalize(a Vec3) Vec3: scale(a, 1.0 / sqrt(dot(a, a)))

/// The distance along the ray from the origin in `direction` to `sphere`, or
/// a negative number when it misses.
fn hit(sphere Sphere, direction Vec3) float
    let oc = scale(sphere.center, -1.0)
    let b = dot(oc, direction)
    let c = dot(oc, oc) - sphere.radius * sphere.radius
    let discriminant = b * b - c
    if discriminant < 0.0
        return -1.0
    -b - sqrt(discriminant)

fn scene() [Sphere]
    List([
        Sphere(center: Vec3(x: 0.0, y: 0.0, z: 5.0), radius: 1.0),
        Sphere(center: Vec3(x: 1.5, y: 0.5, z: 6.0), radius: 1.0),
        Sphere(center: Vec3(x: -1.5, y: -0.5, z: 4.5), radius: 0.75),
        Sphere(center: Vec3(x: 0.0, y: -101.0, z: 5.0), radius: 100.0)
    ])

/// Trace an n by n image of the scene, shading each hit by the angle to a
/// light; the pixels folded into one number, and how many rays hit.
fn kernel(n int) String
    let spheres = scene()
    let light = normalize(Vec3(x: -1.0, y: 1.0, z: -1.0))
    var hash = 0
    var hits = 0
    var py = 0
    while py < n
        var px = 0
        while px < n
            let direction = normalize(Vec3(x: (px as float) / (n as float) - 0.5, y: 0.5 - (py as float) / (n as float), z: 1.0))
            var nearest = 1000000.0
            var shade = 0
            for sphere in spheres
                let t = hit(sphere, direction)
                if t > 0.0 and t < nearest
                    nearest = t
                    let normal = normalize(sub(scale(direction, t), sphere.center))
                    let lambert = dot(normal, light)
                    shade = if lambert > 0.0: (lambert * 255.0) as int else: 0
            if nearest < 1000000.0
                hits += 1
            hash = (hash * 31 + shade) % 1000000007
            px += 1
        py += 1
    f"{hash} {hits}"

/// The integer in the file at `path`; a missing file or anything else in it
/// ends the program with status 2, as in every other port.
fn read_input(path String) int
    let fs = Fs()
    match fs.read_file(path)
        Result.Ok(text)
            match text.trim().to_int()
                Some(n): return n
                None
                    exit(2)
                    return 0
        Result.Err(_)
            exit(2)
            return 0

/// Run the kernel untimed and then timed, report each timed iteration on
/// stderr, and refuse to print a checksum any iteration disagrees with.
fn run_hot(input int) String
    let clock = Clock()
    let expected = kernel(input)
    var agree = true
    var i = 1
    while i < 5
        if kernel(input) != expected
            agree = false
        i += 1
    i = 0
    while i < 5
        let start = clock.now()
        let checksum = kernel(input)
        let elapsed = start.elapsed(clock).as_nanos()
        eprintln(f"hot_ns={elapsed}")
        if checksum != expected
            agree = false
        i += 1
    if not agree
        eprintln("checksum differs between iterations")
        exit(1)
    expected

let args = Args()
let input = read_input(args.element_at(0))
if args.length() > 1 and args.element_at(1) == "hot"
    println(run_hot(input))
else
    println(kernel(input))
