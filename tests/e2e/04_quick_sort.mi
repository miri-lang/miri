// Quick Sort algorithm implementation.

use system.io
use system.time
use system.collections.list


// The list is sorted through the parameter itself, using `set` rather than
// index assignment. Rebinding it to a local first would make the local an
// independent copy on the first write, so the sort would be discarded when the
// function returns.
fn partition(arr List<int>, low int, high int) int
    let pivot = arr[high]
    var i = low - 1
    var j = low
    while j < high
        if arr[j] <= pivot
            i += 1
            let temp = arr[i]
            arr.set(i, arr[j])
            arr.set(j, temp)
        j += 1

    let temp = arr[i + 1]
    arr.set(i + 1, arr[high])
    arr.set(high, temp)
    return i + 1

fn quick_sort(arr List<int>, low int, high int)
    if low < high
        let pivot_idx = partition(arr, low, high)
        quick_sort(arr, low, pivot_idx - 1)
        quick_sort(arr, pivot_idx + 1, high)

fn main()
    let data = List<int>([10, 80, 30, 90, 40, 50, 70])
    
    print("Unsorted list: ")
    for x in data: print(f"{x} ")
    println()
    
    let start = nanotime()
    quick_sort(data, 0, data.length() - 1)
    let end = nanotime()
    
    print("Sorted list:   ")
    for x in data: print(f"{x} ")
    println()
    println(f"Time taken: {end - start} ns")
